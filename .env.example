# URL pública del sitio (usada para SEO y metadata)
NEXT_PUBLIC_SITE_URL=https://devsolution.cl

# Clave de sitio de Cloudflare Turnstile (pública, se usa en el cliente)
# Regístrala en https://www.cloudflare.com/products/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000000000000

# NOTA: copia este archivo a .env.local y rellena con tus valores reales.
# Nunca subas .env.local al repositorio.
